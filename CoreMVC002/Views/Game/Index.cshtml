@model CoreMVC002.Models.XAXBEngine

@{
    ViewData["Title"] = "XA1B 猜數字遊戲";
}

<h2>XA1B 猜數字遊戲</h2>

@if (Model.IsGameOver)
{
    <div class="alert alert-success mt-3" role="alert">
        <h4>🎉 恭喜你猜對了！答案就是 @Model.TargetAnswer</h4>
        <p>總共猜了 <strong>@Model.History.Count</strong> 次！是否要重新再玩一次？</p>
        <a asp-action="Restart" class="btn btn-primary">重新開始新遊戲</a>
    </div>
}
else
{
    <form asp-action="Guess" method="post" class="row g-3 align-items-center mt-2">
        <div class="col-auto">
            <label class="col-form-label">請輸入你的猜測（4 位數字）：</label>
        </div>
        <div class="col-auto">
            <input type="text" name="guess" class="form-control" maxlength="4" required autofocus />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">猜！</button>
        </div>
        <div class="col-auto">
            <a asp-action="Restart" class="btn btn-outline-secondary">重新開始</a>
        </div>
    </form>
}

<hr />

<h4>累計猜測次數：<span class="badge bg-info text-dark">@Model.History.Count</span> 次</h4>

<h4 class="mt-4">猜測歷史紀錄</h4>
@if (Model.History.Count > 0)
{
    <table class="table table-striped table-bordered mt-2" style="max-width: 500px;">
        <thead class="table-dark">
            <tr>
                <th style="width: 20%;">次數</th>
                <th style="width: 40%;">猜測數字</th>
                <th style="width: 40%;">比對結果</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = Model.History.Count - 1; i >= 0; i--)
            {
                <tr>
                    <td>第 @(i + 1) 次</td>
                    <td>@Model.History[i].GuessNumber</td>
                    <td>@Model.History[i].Result</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">尚無猜測紀錄，請開始猜數字！</p>
}